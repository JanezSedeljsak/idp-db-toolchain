# IAM policy for the idp-db-toolchain IRSA role (attach to role referenced in serviceaccount.yaml).
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:HeadBucket"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET",
        "arn:aws:s3:::YOUR_BUCKET/*"
      ]
    }
  ]
}
